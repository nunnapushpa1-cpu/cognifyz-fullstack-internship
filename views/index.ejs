<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">
        <h1>Student Registration Form</h1>

        <% if (error) { %>

<div class="error">
    <%= error %>
</div>

<% } %>
<form action="/submit" method="POST" onsubmit="return validateform();">
    <label>Name:</label><br>
    <input
    type="text"
    name="name"
    id="name"
    value="<%= formData.name || '' %>"><br><br>

    <label>Email:</label><br>
    <input type="email" name="email" id="email" value="<%= formData.email || '' %>"><br><br>

    <label>Phone Number:</label><br>
    <input type="tel" name="phone" id="phone" value="<%= formData.phone || '' %>"><br><br>

    <label>Age:</label><br>
    <input type="number" name="age" id="age" value="<%= formData.age || '' %>"><br><br>

    <label>Address:</label><br>
    <input type="text" name="address" id="address" value="<%= formData.address || '' %>"><br><br>

    <label>Gender:</label><br>
    <select name="gender" id="gender" value="<%= formData.gender || '' %>" required>
         <option value="">Select Gender</option>
         <option>Male</option>
         <option>Female</option>
        </select><br><br>
    

    <label>Course:</label><br>
    <select name="course" id="course" value="<%= formData.course || '' %>" required>
        <option value="">Select a course</option>
        <option>Full Stack Development</option>
        <option>Web Development</option>
        <option>Java</option>
        <option>Python</option>
        </select><br><br>

        <button type="submit">Register</button>

    </form>
    <script src="/validation.js"></script>

    </div>

</body>
</html>
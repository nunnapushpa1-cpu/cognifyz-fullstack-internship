<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Successful</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css">
</head>

<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm py-2">

        <div class="container">

            <a class="navbar-brand fw-bold text-dark" href="/">
                <i class="bi bi-mortarboard-fill me-2"></i>
                Student Registration
            </a>

            <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" href="/students">Students</a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- Success Card -->

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-lg border-0 rounded-4">

                    <div class="card-body p-5">

                        <h2 class="text-success text-center fw-bold mb-4">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            Registration Successful
                        </h2>

                        <table class="table table-bordered">

                            <tr>
                                <th>Name</th>
                                <td><%= name %></td>
                            </tr>

                            <tr>
                                <th>Email</th>
                                <td><%= email %></td>
                            </tr>

                            <tr>
                                <th>Phone</th>
                                <td><%= phone %></td>
                            </tr>

                            <tr>
                                <th>Address</th>
                                <td><%= address %></td>
                            </tr>

                            <tr>
                                <th>Age</th>
                                <td><%= age %></td>
                            </tr>

                            <tr>
                                <th>Gender</th>
                                <td><%= gender %></td>
                            </tr>

                            <tr>
                                <th>Course</th>
                                <td><%= course %></td>
                            </tr>

                        </table>

                        <div class="text-center mt-4">

                            <a href="/" class="btn btn-primary me-2">
                                <i class="bi bi-house-fill me-2"></i>
                                Home
                            </a>

                            <a href="/students" class="btn btn-success">
                                <i class="bi bi-people-fill me-2"></i>
                                View Students
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <footer class="text-center mt-5 mb-3 text-muted">
        <small>© 2026 Student Registration System | Cognifyz Internship</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
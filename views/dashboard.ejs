<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Admin Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="/dashboard.css">

<link rel="stylesheet" href="/style.css">

</head>

<body class="dashboard-body">

<div class="dashboard">

    <!-- Sidebar -->

    <aside class="sidebar">

        <div class="logo">
            🎓 StudentHub
        </div>
    

        <ul class="menu">

            <a href="/" class="btn btn-outline-secondary">
    <i class="bi bi-house-door"></i> Home
</a>

    <li class="active">
        <a href="/admin/dashboard">📊 Dashboard</a>
    </li>

    <li>
        <a href="/admin/students">👨‍🎓 Students</a>
    </li>

    <li>
        <a href="/admin/register">➕ Register Student</a>
    </li>

    <li>
        <a href="/admin/analytics">📈 Analytics</a>
    </li>

    <li>
        <a href="/admin/settings">⚙ Settings</a>
    </li>

    <li>
        <a href="/admin/logout">🚪 Logout</a>
    </li>

</ul>

    </aside>

    <!-- Main -->

    <main class="main-content">

        <div class="topbar">

            <div>

                <h2>Welcome Back 👋</h2>

                <p>Student Management Dashboard</p>

            </div>

        </div>

        <!-- Cards -->

        <div class="cards">

            <div class="card-box">

                <h5>Total Students</h5>

                <h2><%= students.length %></h2>

            </div>

            <div class="card-box">

                <h5>Courses</h5>

                <h2>4</h2>

            </div>

            <div class="card-box">

                <h5>Status</h5>

                <h2>Active</h2>

            </div>

            <div class="card-box">

                <h5>Admin</h5>

                <h2>Online</h2>

            </div>

        </div>

    </main>

</div>

<div class="quick-actions">

    <h3>⚡ Quick Actions</h3>

    <div class="recent-students mt-5">

    <h3>👨‍🎓 Recent Students</h3>

    <% if(students.length===0){ %>

        <p class="text-muted mt-3">
            No students registered yet.
        </p>

    <% } else { %>

        <table class="table mt-3">

            <thead>

                <tr>

                    <th>Name</th>

                    <th>Course</th>

                    <th>Email</th>

                </tr>

            </thead>

            <tbody>

                <% students.slice().reverse().slice(0,5).forEach(student=>{ %>

                    <tr>

                        <td><%= student.name %></td>

                        <td><%= student.course %></td>

                        <td><%= student.email %></td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</div>

    <div class="action-buttons">

        <a href="/admin/register" class="btn btn-primary">
            ➕ Register Student
        </a>

        <a href="/admin/students" class="btn btn-success">
            👨‍🎓 Manage Students
        </a>

    </div>

</div>

</body>

</html>
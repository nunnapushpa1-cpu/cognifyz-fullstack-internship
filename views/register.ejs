<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Register Student</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/style.css">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

</head>

<body>
    <nav class="navbar navbar-expand-lg custom-navbar">
    <div class="container">

        <a href="/admin/dashboard" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>

        <h4 class="mx-auto fw-bold text-primary mb-0">
            Student Registration
        </h4>

    </div>
</nav>

<div class="container mt-4">
    <div class="row justify-content-center">

<div class="col-lg-7">

        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-body p-5">

                <div class="form-header">

    <div class="form-icon">

        <i class="bi bi-person-plus-fill"></i>

    </div>

    <h2>Student Registration</h2>

    <p>Create a new student profile</p>

</div>

                <% if (error) { %>

                    <div class="alert alert-danger">
                        <%= error %>
                    </div>

                <% } %>

                <form action="/submit" method="POST">

                    <div class="mb-3">

                        <label class="form-label">

<i class="bi bi-person"></i>

Full Name

</label>

                        <input
                            type="text"
                            name="name"
                            id="name"
                            class="form-control"
                            value="<%= formData.name || '' %>">

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

<i class="bi bi-envelope"></i>

Email Address

</label>

                        <input
                            type="email"
                            name="email"
                            id="email"
                            class="form-control"
                            value="<%= formData.email || '' %>">

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

<i class="bi bi-telephone"></i>

Phone Number

</label>

                        <input
                            type="tel"
                            name="phone"
                            id="phone"
                            class="form-control"
                            value="<%= formData.phone || '' %>">

                    </div>

                    <div class="row">

    <div class="col-md-6">

        <div class="mb-3">

            <label class="form-label">
                <i class="bi bi-cake2"></i>
                Age
            </label>

            <input
                type="number"
                name="age"
                id="age"
                class="form-control"
                value="<%= formData.age || '' %>">

        </div>

    </div>

    <div class="col-md-6">

        <div class="mb-3">

            <label class="form-label">
                <i class="bi bi-gender-ambiguous"></i>
                Gender
            </label>

            <select
                name="gender"
                id="gender"
                class="form-select">

                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>

            </select>

        </div>

    </div>

</div>

                    

                    <div class="mb-3">

                        <label class="form-label">

<i class="bi bi-geo-alt"></i>

Address

</label>

                        <input
                            type="text"
                            name="address"
                            id="address"
                            class="form-control"
                            value="<%= formData.address || '' %>">

                    </div>

                    <div class="mb-4">

                        <label class="form-label">

<i class="bi bi-mortarboard"></i>

Course

</label>

                        <select
                            name="course"
                            id="course"
                            class="form-select">

                            <option value="">Select Course</option>
                            <option>Full Stack Development</option>
                            <option>Web Development</option>
                            <option>Java</option>
                            <option>Python</option>

                        </select>

                    </div>

                    <button
    type="submit"
    class="btn btn-primary btn-lg w-100 py-3 fw-semibold register-btn">
    <i class="bi bi-person-plus-fill me-2"></i>
    Register Student
</button>
            

                       </form>

            </div>
            </div>

        </div>

    </div>
    </div>

    <!-- Bootstrap JS -->
<footer class="text-center mt-5 mb-3 text-muted">
    <small>© 2026 Student Registration System | Cognifyz Internship</small>
</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Validation -->

    <script src="/validation.js"></script>
</div>

</div>

</section>
</body>
</html>